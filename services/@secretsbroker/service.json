{
  "id": "@secretsbroker",
  "name": "Service Lasso Secrets Broker",
  "description": "Release-backed local-first secrets broker for Service Lasso bootstrap, service identities, policy, audit, and secret resolution.",
  "version": "2026.8.31-f340883",
  "enabled": true,
  "env": {
    "SECRETSBROKER_MODE": "production",
    "SECRETSBROKER_TRANSPORT": "auto"
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-secretsbroker",
      "tag": "2026.8.31-f340883"
    },
    "platforms": {
      "win32": {
        "assetName": "secretsbroker-win32.zip",
        "archiveType": "zip",
        "command": ".\\secretsbroker.exe",
        "args": ["serve"],
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      },
      "linux": {
        "assetName": "secretsbroker-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./secretsbroker",
        "args": ["serve"],
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      },
      "darwin": {
        "assetName": "secretsbroker-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./secretsbroker",
        "args": ["serve"],
        "checksum": {
          "algorithm": "sha256",
          "assetName": "SHA256SUMS.txt"
        }
      }
    }
  },
  "healthchecks": [
    {
      "id": "secretsbroker-process-health",
      "type": "process",
      "retries": 80,
      "interval": 250
    }
  ]
}
