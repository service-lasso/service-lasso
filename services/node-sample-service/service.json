{
  "id": "node-sample-service",
  "name": "Node Sample Service",
  "description": "Tracked provider-backed sample service used to prove real @node execution, non-secret config updates, and Secrets Broker rotation through the core runtime.",
  "version": "0.1.0",
  "enabled": true,
  "depend_on": [
    "@node"
  ],
  "execservice": "@node",
  "args": [
    "${SERVICE_ROOT}/runtime/server.mjs"
  ],
  "env": {
    "NODE_SAMPLE_ENV_PATH": "./.state/provider-env.json",
    "NODE_SAMPLE_PORT": "${SERVICE_PORT}",
    "NODE_SAMPLE_PUBLIC_LABEL": "node-sample",
    "NODE_SAMPLE_FEATURE_FLAG": "rotation-fixture",
    "NODE_SAMPLE_PUBLIC_URL": "http://127.0.0.1:${SERVICE_PORT}/",
    "NODE_SAMPLE_API_TOKEN": "${sample.API_TOKEN}",
    "NODE_SAMPLE_GENERATED_TOKEN": "${sample.GENERATED_TOKEN}"
  },
  "config": {
    "files": [
      {
        "path": "./runtime/sample-config.json",
        "content": "{\n  \"publicLabel\": \"${NODE_SAMPLE_PUBLIC_LABEL}\",\n  \"featureFlag\": \"${NODE_SAMPLE_FEATURE_FLAG}\",\n  \"publicUrl\": \"${NODE_SAMPLE_PUBLIC_URL}\"\n}\n"
      }
    ]
  },
  "ports": {
    "service": 4020
  },
  "urls": [
    {
      "label": "service",
      "url": "http://127.0.0.1:${SERVICE_PORT}",
      "kind": "local"
    },
    {
      "label": "health",
      "url": "http://127.0.0.1:${SERVICE_PORT}/health",
      "kind": "local"
    },
    {
      "label": "diagnostics",
      "url": "http://127.0.0.1:${SERVICE_PORT}/diagnostics",
      "kind": "local"
    }
  ],
  "healthchecks": [
    {
      "id": "http-health",
      "type": "http",
      "url": "http://127.0.0.1:${SERVICE_PORT}/health",
      "expected_status": 200,
      "retries": 80,
      "interval": 250
    }
  ],
  "broker": {
    "enabled": true,
    "namespace": "services/node-sample-service",
    "buckets": [
      {
        "namespace": "services/node-sample-service",
        "kind": "service"
      },
      {
        "namespace": "shared/sample",
        "kind": "shared"
      }
    ],
    "imports": [
      {
        "namespace": "shared/sample",
        "ref": "sample.API_TOKEN",
        "as": "NODE_SAMPLE_API_TOKEN",
        "required": false,
        "onChange": {
          "mode": "restart",
          "reason": "reload optional sample API token after operator rotation"
        }
      },
      {
        "namespace": "services/node-sample-service",
        "ref": "sample.GENERATED_TOKEN",
        "as": "NODE_SAMPLE_GENERATED_TOKEN",
        "required": true,
        "onChange": {
          "mode": "restart",
          "reason": "reload generated sample token after first-run onboard or rotation"
        }
      }
    ],
    "accessPolicy": {
      "serviceId": "node-sample-service",
      "workspace": "local-demo",
      "grants": [
        {
          "namespace": "shared/sample",
          "scope": "shared",
          "refs": ["sample.API_TOKEN"],
          "operations": ["resolve"],
          "purpose": "optionally read a shared sample API token during runtime startup"
        },
        {
          "namespace": "services/node-sample-service",
          "scope": "service",
          "refs": ["sample.GENERATED_TOKEN"],
          "operations": ["resolve", "create", "rotate"],
          "purpose": "first-run generate, resolve, and rotate the sample producer token"
        }
      ]
    },
    "writeback": {
      "allowedNamespaces": [
        "services/node-sample-service"
      ],
      "allowedOperations": [
        "create",
        "rotate"
      ],
      "allowedRefs": [
        "sample.GENERATED_TOKEN"
      ],
      "allowOverwrite": false,
      "auditReason": "first-run sample producer token onboard",
      "generatedSecrets": [
        {
          "ref": "sample.GENERATED_TOKEN",
          "source": "broker:generate",
          "operation": "create",
          "required": true
        }
      ]
    },
    "exports": [
      {
        "namespace": "services/node-sample-service",
        "ref": "sample.GENERATED_TOKEN",
        "source": "broker:generate",
        "required": true
      }
    ]
  }
}
