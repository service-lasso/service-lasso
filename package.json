{
  "name": "service-lasso",
  "version": "0.1.0",
  "private": true,
  "description": "Core runtime and contract repository for Service Lasso.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/image-size-safe"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/**/*.test.js",
    "dev": "npm run build && node --enable-source-maps dist/index.js",
    "start": "npm run build && node --enable-source-maps dist/index.js",
    "release:artifact": "npm run build && node scripts/release-artifact.mjs",
    "release:verify": "npm run build && node scripts/release-verify.mjs",
    "package:stage": "npm run build && node scripts/publish-package.mjs",
    "package:verify": "npm run build && node scripts/publish-package-verify.mjs",
    "verify:package-consumer": "npm run build && node scripts/verify-package-consumer.mjs",
    "verify:baseline-start": "npm run build && node scripts/baseline-start-smoke.mjs",
    "verify:real-app-e2e": "npm run build && node scripts/verify-real-app-e2e.mjs",
    "verify:auth-e2e": "npm run build && node scripts/verify-auth-e2e.mjs",
    "verify:multi-instance-ports": "npm run build && node scripts/verify-multi-instance-ports.mjs",
    "verify:service-catalog": "npm run build && node scripts/verify-service-catalog.mjs",
    "local:multi-instance": "npm run build && node scripts/start-local-multi-instance.mjs",
    "verify:reference-app-lifecycle": "npm run build && node scripts/verify-reference-app-lifecycle.mjs",
    "verify:service-updates": "npm run build && node scripts/verify-service-updates.mjs",
    "verify:recovery-hooks": "npm run build && node scripts/verify-recovery-hooks.mjs",
    "verify:echo-health": "npm run build && node scripts/verify-release-backed-echo-health.mjs",
    "verify:traefik-release": "npm run build && node scripts/verify-release-backed-traefik.mjs",
    "demo": "npm run build && node scripts/demo-start.mjs --port=17883",
    "demo:start": "npm run build && node scripts/demo-start.mjs --port=17883",
    "demo:watchdog": "npm run build && node scripts/demo-watchdog.mjs",
    "demo:recycle": "npm run build && node scripts/demo-recycle.mjs",
    "demo:gate": "npm run build && node scripts/demo-gate.mjs --port=17883",
    "demo:status": "node scripts/demo-status.mjs",
    "demo:verify-canonical": "node scripts/demo-verify-canonical.mjs",
    "demo:worktree-proof": "npm run build && node scripts/demo-worktree-proof.mjs",
    "demo:reset": "npm run build && node scripts/demo-reset.mjs",
    "demo:deploy-canonical": "npm run build && node scripts/demo-deploy-canonical.mjs",
    "demo:smoke": "npm run build && node scripts/demo-smoke.mjs",
    "docs:start": "docusaurus start docs",
    "docs:build": "docusaurus build docs",
    "docs:serve": "docusaurus serve docs",
    "docs:clear": "docusaurus clear docs",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "audit:tooling": "npm audit --audit-level=high",
    "release:assets:expected": "node scripts/check-release-assets.mjs --expected",
    "release:assets:check": "node scripts/check-release-assets.mjs",
    "bootstrap:local-sso": "node scripts/local-sso-bootstrap.mjs",
    "test:local-sso": "npm run build && node --test --test-concurrency=1 tests/local-sso-bootstrap.test.js",
    "test:local-sso-loop": "npm run build && node --test --test-concurrency=1 tests/local-sso-loop-smoke.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "adm-zip": "0.6.0",
    "tar": "7.5.22",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "serialize-javascript": "7.1.0"
  }
}
